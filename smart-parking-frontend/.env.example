# Frontend environment variables (Vite).
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.

# Stripe publishable key — enables live card collection in the payment modals.
# Leave unset to run without Stripe (the UI shows a configuration notice and the
# backend uses its Stripe mock mode).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
