# MongoDB
MONGO_CONNECTION_STRING=mongodb://localhost:27017
MONGO_DATABASE_NAME=SmartParkingDb

# Backend URLs
ASPNETCORE_URLS=http://localhost:5126
LICENSE_PLATE_API_BASE_URL=http://localhost:4050
STREAMING_API_BASE_URL=http://localhost:4051
STREAMING_API_TIMEOUT_SECONDS=10
APP_BASE_URL=http://localhost:3000

# AI service resilience
AI_SERVICE_TIMEOUT_SECONDS=10
AI_SERVICE_RETRY_MAX_ATTEMPTS=3
AI_SERVICE_CIRCUIT_FAILURE_THRESHOLD=5
AI_SERVICE_CIRCUIT_BREAK_DURATION_SECONDS=30

# Camera processing queue
CAMERA_PROCESSING_QUEUE_CAPACITY=500
CAMERA_PROCESSING_MAX_ATTEMPTS=3

# Optional live Flask contract tests
SMARTPARKING_RUN_FLASK_CONTRACT_TESTS=false
SMARTPARKING_LICENSE_PLATE_API=http://localhost:4050
SMARTPARKING_TEST_MONGODB=mongodb://localhost:27017

# Security
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRY_HOURS=8

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_SENDER_EMAIL=CHANGE_ME
SMTP_SENDER_NAME=Smart Parking System

# Admin bootstrap (used only when user collection is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Payment gateways
MOMO_PARTNER_CODE=CHANGE_ME
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_API_ENDPOINT=https://test-payment.momo.vn/gw_payment/transactionProcessor
MOMO_RETURN_URL=http://localhost:3000/payment/momo/return
MOMO_NOTIFY_URL=http://localhost:5126/api/payment/webhook/momo

STRIPE_API_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_MOCK_MODE=false

# Frontend (Vite)
VITE_API_BASE_URL=
VITE_STREAMING_API_BASE_URL=http://localhost:4051

# Python Flask services
FLASK_HOST=0.0.0.0
FLASK_PORT=4050
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
